tt_content {
    t3upheaderimage_content = FLUIDTEMPLATE

    t3upheaderimage_content {
        templateName = Headerimage

        templateRootPaths {
            10 = EXT:t3up/Resources/Private/ContentElements/Templates/
            20 = EXT:t3up_headerimage/Resources/Private/Templates/
        }

        partialRootPaths {
            10 = EXT:t3up/Resources/Private/ContentElements/Partials/
        }

        layoutRootPaths {
            10 = EXT:t3up/Resources/Private/ContentElements/Layouts/
        }

        dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
            10 {
                references.fieldName = assets
                as = image
            }
            30 = TYPO3\CMS\Frontend\DataProcessing\FlexFormProcessor
        }
    }
}

page.includeCSS{
   	t3up_headerimage                 = EXT:t3up_headerimage/Resources/Public/Sass/_t3upHeaderimage.scss
    t3up_headerimage.linenumber      = true    
}


page.includeJSFooterlibs {
    t3upheaderimage                  = EXT:t3up_headerimage/Resources/Public/JavaScript/t3upheaderimage.js
    t3upheaderimage.async            = 1
        
}
