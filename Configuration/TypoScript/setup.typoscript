lib.contentElement {
	templateRootPaths {
		111 						= EXT:t3up_headerimage/Resources/Private/Templates
	}
}
 
tt_content {
	t3upheaderimage_content < lib.contentElement
	t3upheaderimage_content {
		templateName = Headerimage
		dataProcessing {
            10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
            10 {
                references.fieldName = assets
                as = image
            }
		}
		dataProcessing {
            999 = TYPO3\CMS\Frontend\DataProcessing\FlexFormProcessor
		}
	}
}

page.includeCSS{
   	t3up_headerimage                 = EXT:t3up_headerimage/Resources/Public/Sass/_t3upHeaderimage.scss
    t3up_headerimage.linenumber      = true    
}


page.includeJSFooterlibs {
    t3upheaderimage                  = EXT:t3up_headerimage/Resources/Public/JavaScript/t3upheaderimage.js
    t3upheaderimage.async            = 1
        
}